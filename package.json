{
  "name": "astro-git-dates",
  "version": "1.0.0",
  "description": "Set Astro content collection dates from git: `date: git Last Modified` or `date: git Created`, like Eleventy",
  "keywords": [
    "astro",
    "astro-loader",
    "content-collections",
    "date",
    "eleventy",
    "git",
    "last-modified"
  ],
  "homepage": "https://github.com/mrmartineau/astro-git-dates",
  "bugs": {
    "url": "https://github.com/mrmartineau/astro-git-dates/issues"
  },
  "license": "ISC",
  "author": {
    "name": "Zander Martineau",
    "email": "zander@zander.wtf",
    "url": "https://zander.wtf"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mrmartineau/astro-git-dates.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "check": "vp check --fix",
    "dev": "tsdown --watch",
    "prepare": "vp config",
    "release": "semantic-release",
    "test": "bun test"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.0",
    "@types/bun": "^1.3.10",
    "@types/node": "^25.4.0",
    "astro": "^7.0.6",
    "semantic-release": "^25.0.3",
    "tsdown": "^0.21.2",
    "typescript": "^5.9.3",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "astro": "^5.0.0 || ^6.0.0 || ^7.0.0"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@11.10.0"
}
